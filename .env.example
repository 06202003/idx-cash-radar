# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Admin Telegram Chat ID allowed to run /settoken and receive 401 expiry alerts
ADMIN_CHAT_ID=

# Stockbit Bearer JWT token (from stockbit.com DevTools -> Authorization: Bearer ...)
STOCKBIT_BEARER_TOKEN=

# Your Telegram Chat ID for 08:45 WIB & 18:00 WIB serverless cron alerts (get via @userinfobot)
DEFAULT_CHAT_ID=

# Comma-separated watchlist for Vercel serverless cron (optional, defaults to top universe)
DEFAULT_WATCHLIST=ADRO,BBRI,BBCA,TLKM,ANTM

# Optional secret token to protect /api/cron/* endpoints
CRON_SECRET=

# Optional: IDX Cash Radar API base URL for fundamental cash-safety cross-check
CASH_RADAR_API_URL=https://idx-cash-radar.vercel.app

# Alert schedule (WIB / Asia/Jakarta)
MORNING_ALERT_HOUR=8
MORNING_ALERT_MINUTE=45
EVENING_RECAP_HOUR=18
EVENING_RECAP_MINUTE=0

# Round-trip transaction fee assumption for honest backtest (0.4% = 0.004)
ROUND_TRIP_FEE=0.004
