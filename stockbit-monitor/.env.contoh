# Salin jadi .env lalu isi nilai asli LANGSUNG DI SERVER (jangan pernah ditempel di chat).
#   cp .env.contoh .env && nano .env

# Kredensial Stockbit TIDAK diisi di sini -- login/v6 sekarang wajib reCAPTCHA v3
# yang tidak bisa dijalankan lewat script biasa. Sesi diisi manual lewat token
# cache, lihat set_token.py (login lewat browser asli, ambil access+refresh token).

# --- Bot Telegram alert (buat baru lewat @BotFather, JANGAN pakai punya bot trading lain) ---
TELEGRAM_BOT_TOKEN=
# chat_id tujuan alert (chat pribadi Anda atau grup). Cara cepat dapat chat_id:
# chat sesuatu ke bot barunya dulu, lalu buka:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# --- Deteksi lonjakan aktivitas per saham (Z-score, threshold otomatis beda tiap saham) ---
# Nggak ada threshold rupiah tetap sama sekali -- pas saham baru mulai diamati dan
# belum punya cukup histori (~SURGE_MIN_BUCKETS x SURGE_SHORT_WINDOW_SEC), belum ada
# alert dulu buat saham itu (dianggap masa pengumpulan data), bukan pakai angka tebakan.
# window "sekarang" yang dibandingkan (detik) -- juga otomatis nangkep order yang dipecah
SURGE_SHORT_WINDOW_SEC=180
# window histori buat bangun baseline "kebiasaan" saham itu (detik)
SURGE_LONG_WINDOW_SEC=1800
# minimal berapa window historis (selebar SURGE_SHORT_WINDOW_SEC) sebelum baseline dipakai (cold-start)
SURGE_MIN_BUCKETS=5
# alert kalau Z-score >= segini (3.0 = signifikan secara statistik, standar umum)
SURGE_Z_THRESHOLD=3.0
# batas bawah absolut (Rupiah) -- 0 = murni relatif, nggak ada syarat rupiah sama sekali,
# cuma Z-score. Kalau nanti ternyata masih berisik dari saham yang baseline-nya sendiri
# receh (jadi lonjakan kecil = Z besar), naikkan angka ini sebagai syarat TAMBAHAN
# (bukan pengganti Z-score) biar minimal ada uang beneran yang lolos.
SURGE_FLOOR_IDR=0
# jeda minimal antar alert lonjakan buat saham yang sama (detik)
SURGE_COOLDOWN_SEC=240
# minimal variasi historis yang dianggap wajar (persentase dari rata-rata), biar saham
# yang histori-nya kebetulan SANGAT stabil (variasi hampir nol) nggak dapat Z-score
# meledak (puluhan-ratusan) cuma dari kenaikan kecil yang sebenarnya bukan anomali
SURGE_MIN_RELATIVE_STDDEV=0.3

# --- Digest ringkasan Buy/Sell per saham (diadopsi dari bot referensi "Power Buy/Sell") ---
# pelengkap alert lonjakan -- dikirim otomatis begitu satu saham kena kelipatan alert
# tertentu hari itu, nunjukin tren buy vs sell per bucket waktu sepanjang hari + kesimpulan.
# lebar tiap bucket waktu di tabel digest (menit)
POWER_BUCKET_MINUTES=10
# kirim digest tiap kelipatan sekian alert buat saham yang sama (5 = alert ke-5, ke-10, dst)
POWER_DIGEST_EVERY=5

# --- Konteks & penilaian di tiap alert (lihat market_context.py) ---
# Tiap alert dikasih kode penilaian: CHASE (HAKA setelah harga lari), KNIFE (HAKA berulang
# di saham turun >=5%), ILLIQ_BUY / ILLIQ_SELL (saham tidak likuid), BUY_PLAIN (HAKA tanpa
# konteks), EXIT (HAKI setelah harga lari), SELL_DROP (HAKI saat turun), SELL_PLAIN.
# Kode yang ditulis di sini TIDAK dikirim ke Telegram (tetap tercatat di data/alerts-*.jsonl).
# Kosong = semua dikirim. Contoh buat ngurangin berisik: ILLIQ_BUY,ILLIQ_SELL,SELL_DROP
ALERT_MUTE_CODES=
# alert 1 transaksi pasar nego/crossing >= sekian rupiah (0 = matikan)
NEGO_ALERT_IDR=10000000000

# --- Rekap broksum sore (lihat broksum.py) ---
# setelah tutup, tarik broker summary saham yang paling sering kena alert hari itu
# (1 = nyala, 0 = mati). Manual: /rekap, atau /broksum KODE buat 1 saham.
EOD_RECAP=1
# jam kirim (WIB) -- jangan terlalu mepet tutup, broksum butuh waktu sampai lengkap
EOD_RECAP_TIME=18:00
# ikut kirim screening "dijaga & sepi" (narik broksum semua saham di data/universe.json,
# ~5 menit tiap sore). 0 = matikan; manual tetap bisa lewat /akumulasi
ACC_SCREEN=1
# baris teknikal harian (tren, RSI, support/resisten) di tiap alert; harga dari Yahoo Finance
ALERT_TECHNICAL=1
# minimal jumlah alert hari itu biar saham ikut direkap, dan maksimal berapa saham
EOD_RECAP_MIN_ALERTS=3
EOD_RECAP_MAX_STOCKS=25

# --- Jam pantau (WIB, format HH:MM) ---
MARKET_OPEN=08:55
MARKET_CLOSE=16:20

LOG_LEVEL=INFO

# --- Watchlist otomatis dari running trade (lihat watchlist.py) ---
# Bot milih sendiri saham yang dipantau lebih dekat: masuk kalau kena alert BELI berulang
# dengan arah konsisten & likuid; dikabari kalau naik, ada lonjakan jual, atau keluar.
# Uji 16-20 Nov 2026: rata-rata TIDAK naik sampai tutup -> daftar fokus, BUKAN sinyal beli.
# Perintah: /pantau, /pantau KODE (tambah manual), /lepas KODE. 0 = matikan.
WATCH_AUTO=1
# syarat masuk: minimal alert beli hari ini & porsi alert beli dari total alert saham itu
WATCH_MIN_BUY_ALERTS=3
WATCH_MIN_BUY_SHARE=0.7
# maksimal saham dipantau bersamaan
WATCH_MAX_ACTIVE=10
# keluar kalau turun sekian % dari harga masuk / dari puncak sejak masuk
WATCH_STOP_PCT=3
WATCH_TRAIL_PCT=3
# kabar "naik" tiap kelipatan sekian % dari harga masuk
WATCH_STEP_PCT=2
# arus berbalik: porsi nilai JUAL dalam window ini >= WATCH_FLIP_SELL_SHARE -> keluar
WATCH_FLOW_WINDOW_MIN=15
WATCH_FLIP_SELL_SHARE=0.65
# keluar kalau sekian menit tanpa lonjakan beli baru (biar slot nggak nyangkut seharian)
WATCH_IDLE_MIN=60
# keluar setelah sekian lonjakan jual sejak masuk (yang pertama cuma peringatan)
WATCH_MAX_SELL_ALERTS=2

# --- Pengumpul orderbook saham pantauan (lihat orderbook.py) ---
# TAHAP 1: hanya kumpul data ke data/orderbook/, belum ada alert.
# Path endpoint orderbook Stockbit (hasil intip DevTools > Network di Stockbit web),
# {code} = kode saham. KOSONG = mati, tidak ada request sama sekali.
ORDERBOOK_PATH=/company-price-feed/v2/orderbook/companies/{code}
# jeda antar putaran (detik); tiap putaran ambil semua saham pantauan, request disebar
ORDERBOOK_INTERVAL_SEC=10
# berapa level bid/offer yang disimpan
ORDERBOOK_LEVELS=10
# batas ukuran file per hari (MB) -- disk VPS sempit
ORDERBOOK_MAX_MB_PER_DAY=50

# --- Pendeteksi pola di saham pantauan (lihat obdetect.py) ---
# TAHAP 1: hanya catat kandidat ke data/obdetect-YYYY-MM.jsonl + perintah /pola, tanpa alert.
# tembok = level >= sekian x median level lain di sisi itu DAN nilainya >= OBD_WALL_MIN_IDR
OBD_WALL_MULT=5
OBD_WALL_MIN_IDR=250000000
# tembok dianggap dicabut kalau menyusut >= sekian (0.7 = 70%) tanpa harga menyentuh levelnya
OBD_PULL_FRAC=0.7
# pola algo: broker sama jadi agresor >= sekian kali dalam 10 mnt dengan variasi lot <= OBD_ALGO_MAX_CV
OBD_ALGO_MIN_TRADES=6
OBD_ALGO_MAX_CV=0.15

# --- Broksum adaptif (lihat broksum_adaptive.py) ---
# Sesudah rekap sore: saham rekap + saham watchlist hari itu dicek 5 pemicu (A data kurang,
# B konsentrasi 35-55%, C penampung utama buang >=20% dalam 3 hari, D harga gerak >=10% dlm
# 10 hari, E running trade beli tapi broksum distribusi). Yang kena -> tarik data lebih
# panjang (cache dulu, query rentang kalau bolong). Hasil: pesan "Broksum lanjutan" + log
# data/broksum-adaptive-YYYY-MM.jsonl. Pemicu belum teruji. 0 = matikan.
BROKSUM_ADAPTIVE=1
# maksimal request tambahan ke Stockbit per hari (query rentang + tambal per hari)
BROKSUM_ADAPTIVE_MAX_REQ=60

# --- Pengukuran kelengkapan running trade (lihat measure.py) ---
# Ringan: catat polling yang bolong + celah trade_number (urut satu pasar), lalu setelah
# tutup tarik `frequency` ~25 saham sampel (~25 request) & kirim 1 ringkasan. 0 = matikan.
MEASURE_COVERAGE=1

# --- Tabel bukti harian (lihat evidence.py & HIPOTESIS.md) ---
# Sesudah rekap sore: 1 baris per saham per hari gabungan semua analisa ->
# data/evidence/YYYY-MM-DD.jsonl; kolom hasil (r1/r5) terisi otomatis hari-hari berikutnya.
EVIDENCE_TABLE=1
